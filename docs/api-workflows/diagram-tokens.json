  "typography": {
    "sans": "Inter, 'Segoe UI', Arial, Helvetica, sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Mono', 'Liberation Mono', Consolas, monospace",
    "title": {
      "size": 19,
