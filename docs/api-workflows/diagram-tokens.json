    "regionBorder": 1,
    "primaryPath": 2.8,
    "branchPath": 2.2,
    "errorPath": 1.2,
    "errorDash": "5 4",
    "cornerRadius": 8,
    "icon": 1.5,
    "internalPath": 1.8,
    "responsePath": 3.0,
    "errorOpacity": 0.62
  },
  "shadow": {
    "card": {
      "dy": 1,
      "blur": 2.5,
      "color": "#0F172A",
      "opacity": 0.07
    },
    "region": {
      "dy": 1,
      "blur": 3,
      "color": "#0F172A",
      "opacity": 0.04
    }
  },
  "icons": {
    "note": "18x18 stroke-only vector glyphs defined in workflow_diagram.py ICONS. No emoji.",
    "available": [
      "cursor",
      "window",
      "layout",
      "refresh",
      "key",
      "send",
      "shield",
      "gauge",
      "server",
      "gears",
      "bolt",
      "user-check",
      "database",
      "layers",
      "save",
      "chart",
      "sigma",
      "alert",
      "file-text",
      "monitor",
      "list"
    ]
  },
  "conventions": {
    "flowDirection": "left-to-right across regions; top-to-bottom within a region",
    "regionHandoff": "exit source card right edge -> vertical run in the inter-region gap -> horizontal run in the handoff lane above the region boxes -> down into the top edge of the next region's first card",
    "primaryPath": "solid, semantic colour of the target card, arrowhead at destination",
    "branchPath": "solid green rail on the region's right inset, used for cache short-circuits",
    "errorPath": "red dashed, routed on a region rail, terminating in a red chip inside the region where the failure occurs",
    "cacheDistinction": "Redis = database green + bolt/save icon + 'REDIS' kicker; MongoDB = database green + database icon + 'MONGODB' kicker; TanStack = frontend blue + refresh icon + 'TANSTACK' kicker. Never interchangeable.",
    "levels": "Level 1 overview answers where/auth/cache/miss/returns/consumers in 10-15 s. Level 2 keeps every real function and file name.",
    "stageNumbers": "The 12 Level 1 stage numbers are reused as badges on Level 2 cards, so the two diagrams cross-reference. Several Level 2 cards may share a badge.",
    "errorPlacement": "Level 2 errors live in a dedicated 'Exceptions and Current Limitations' band beneath the regions, linked back by thin red dashed references routed through the gutter so they never cross a card.",
    "arrowWeight": "Inter-region hand-offs are heavier than within-region steps. The 200 OK hand-off is cyan and heaviest."
  },
  "overview": {
    "note": "Level 1 canvas. Same palette, icons and rounded-card system as Level 2; only the density changes. Must stay readable at ~1200 px wide.",
    "canvas": {
      "width": 1600,
      "height": 645,
      "titleBandHeight": 56,
      "margin": 34,
      "footerTop": 576
    },
    "grid": {
      "note": "Nine-column Level 1 grid shared by every endpoint in the set. One row-1 column is normally left empty to carry a cache short-circuit forward, which keeps the flow monotonically left-to-right.",
      "columns": 9,
      "cardWidth": 156,
      "cardHeight": 132,
      "cardGap": 16,
      "columnX": [
        34,
        206,
        378,
        550,
        722,
