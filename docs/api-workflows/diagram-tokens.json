      "line": "#DC2626",
      "fill": "#FEF2F2",
      "border": "#FECACA",
      "ink": "#991B1B"
    }
  },
  "neutral": {
    "regionFill": "#FFFFFF",
    "regionBorder": "#CBD5E1",
    "regionLabel": "#334155",
    "subRegionBorder": "#E2E8F0",
    "ink": "#0F172A",
    "inkMuted": "#475569",
    "inkMono": "#334155",
    "inkFaint": "#64748B",
