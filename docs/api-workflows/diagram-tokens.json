    "footerTop": 1130,
    "margin": 20,
    "regionGap": 14,
    "gutterTop": 886,
    "gutterBottom": 940,
    "bandTop": 940,
    "bandBottom": 1114
  },
  "layout": {
    "cardWidth": 224,
    "cardHeight": 90,
    "cardPitch": 104,
    "cardRadius": 10,
    "regionRadius": 14,
