      "fill": "#ECFEFF",
      "border": "#A5F3FC",
      "ink": "#155E75"
    },
    "ui": {
      "role": "UI / output",
      "line": "#DB2777",
      "fill": "#FDF2F8",
      "border": "#FBCFE8",
      "ink": "#9D174D"
    },
    "error": {
