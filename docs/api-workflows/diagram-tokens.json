      "fill": "#FFFBEB",
      "border": "#FDE68A",
      "ink": "#92400E"
    },
    "backend": {
      "role": "Backend processing",
      "line": "#7C3AED",
      "fill": "#F5F3FF",
      "border": "#DDD6FE",
      "ink": "#5B21B6"
    },
    "database": {
