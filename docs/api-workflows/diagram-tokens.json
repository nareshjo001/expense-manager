{
  "$meta": {
    "name": "BALENISA API Workflow Diagram Tokens",
    "version": "2.0.0",
    "purpose": "Single source of truth for every API workflow diagram in docs/api-workflows. Each endpoint gets two diagrams that share this one token set: a Level 1 overview (fast read) and a Level 2 detailed engineering view.",
    "consumedBy": "workflow_diagram.py"
  },
  "canvas": {
    "width": 1680,
    "height": 1210,
    "background": "#F1F5F9",
