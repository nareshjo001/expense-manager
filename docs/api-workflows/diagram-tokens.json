      "line": "#059669",
      "fill": "#ECFDF5",
      "border": "#A7F3D0",
      "ink": "#065F46"
    },
    "insights": {
      "role": "Analytics / insights",
      "line": "#0D9488",
      "fill": "#F0FDFA",
      "border": "#99F6E4",
      "ink": "#115E59"
    },
    "response": {
