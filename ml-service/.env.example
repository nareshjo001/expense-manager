# BALENISA ml-service environment configuration template.
#
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file -- it is already listed in ml-service/.gitignore. This example
# file contains placeholders only; no real credentials, hosts, or tokens.

# --- Required: MongoDB connectivity -----------------------------------------
# Full connection string, including credentials. Required for the service to
# serve predictions at all reconciliation/training/feedback state lives in
# MongoDB) -- startup fails if this is missing or malformed.
MONGO_CONN=mongodb://<username>:<password>@<host>:<port>/<database>
MONGO_DB_NAME=auth-db

# --- Optional: operational endpoints ----------------------------------------
# Shared secret required (via the X-ML-Operations-Token header) to call
# /ml-status and /training-runs*. If unset, those endpoints fail closed
# (503) rather than being open by default -- see status_api.py.
ML_OPERATIONS_TOKEN=change-me-to-a-long-random-value

# --- Optional: model artifact storage ---------------------------------------
# Root directory for versioned model bundles + active.json. Defaults to
# ml-service/training/models if unset. Must be writable by the service
# process, and must remain on the SAME filesystem the service can perform an
# atomic os.rename/os.replace against (see model_bundle.py) -- do not point
# this at a network mount that does not support atomic rename semantics.
ML_MODEL_ROOT=./training/models

# --- Optional: retraining lifecycle tuning (all have safe defaults) --------
ML_RETRAIN_STALE_TIMEOUT_SECONDS=1800
ML_ORPHANED_RUN_THRESHOLD_SECONDS=300
ML_MANIFEST_CHECK_INTERVAL_SECONDS=5
ML_MAX_ACCURACY_REGRESSION=0.02
ML_FEEDBACK_DUPLICATE_CAP=3

# --- Optional: artifact retention/cleanup -----------------------------------
ML_MODEL_RETENTION_COUNT=5
ML_REJECTED_MODEL_RETENTION_COUNT=3
ML_MODEL_RETENTION_DAYS=7

# --- Test-only: never set these in production -------------------------------
# Used exclusively by tests/integration/* to point at an isolated MongoDB
# database. The name MUST contain "test" (see tests/integration/conftest.py)
# or the test suite refuses to run, to guarantee production data can never
# be touched by an integration test run.
ML_TEST_MONGO_CONN=mongodb://localhost:27017
ML_TEST_MONGO_DB_NAME=auth-db-ml-integration-test
